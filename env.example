# 3dthium — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or real secrets to the repository.
#
# See SECURITY_ROTATION.md for the rotation procedure and dashboard links.

# ---------------------------------------------------------------------------
# Supabase (public — safe to expose in browser bundles)
# Dashboard: https://app.supabase.com → your project → Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ---------------------------------------------------------------------------
# Supabase (server-only — bypasses RLS; NEVER expose to the browser)
# Dashboard: Settings → API → service_role key
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ---------------------------------------------------------------------------
# Stripe
# Dashboard: https://dashboard.stripe.com → Developers → API keys
# STRIPE_SECRET_KEY is server-only. NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is public.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Stripe webhook signing secret — from Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ---------------------------------------------------------------------------
# Shippo (server-only)
# Dashboard: https://app.goshippo.com → API → API Keys
# ---------------------------------------------------------------------------
SHIPPO_API_KEY=your_shippo_api_key

# Shared secret for Shippo webhook verification (you choose this value;
# configure it as a custom header in the Shippo dashboard webhook settings)
SHIPPO_WEBHOOK_SECRET=your_shippo_webhook_secret

# ---------------------------------------------------------------------------
# Database (server-only)
# Supabase Dashboard → Settings → Database → Connection string (URI)
# ---------------------------------------------------------------------------
DATABASE_URL=your_database_connection_string

# ---------------------------------------------------------------------------
# App URL — required for server-side absolute URL construction
# Set to https://yourdomain.com in production; http://localhost:3000 locally
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000
